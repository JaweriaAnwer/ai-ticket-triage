<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.nunomics.ai.executivesummary" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="Nunomics" email="" website="https://nunomics.ai"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>http://localhost:8787/summary.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Executive Summary</text>
    </resource>
    <resource id="description">
      <text locale="en_US">Auto-generated executive insights for this dashboard.</text>
    </resource>
  </resources>
</manifest>
